# RUN: llc -mtriple=x86_64-unknown-linux-gnu --load=%llvmshlibdir/pikhotskiy_r_lab3_BACKEND%shlibext -run-pass=pikhotskiy-inline-backend -verify-machineinstrs %s -o - | FileCheck %s

# The limit counts body instructions, excluding RET and CFI directives.
# Callees remain available because their callers appear first in IR.
--- |
  define void @at_limit() { ret void }
  define void @at_limit_with_cfi() { ret void }
  define void @fifteen_instructions() { ret void }
  define void @fifteen_with_cfi() { ret void }
...
---
name: at_limit
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: at_limit{{$}}
    ; CHECK: bb.0:
    ; CHECK-NEXT: $eax = MOV32ri 18
    ; CHECK-NEXT: $eax = ADD32ri $eax, 2, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 3, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 4, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 5, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 6, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 7, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 8, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 9, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 10, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 11, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 12, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 14, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 15, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @fifteen_instructions
    RET64
...
---
name: at_limit_with_cfi
tracksRegLiveness: true
body: |
  bb.0:
    ; CFI must neither block inlining nor appear in the cloned body.
    ; CHECK-LABEL: name: at_limit_with_cfi
    ; CHECK: bb.0:
    ; CHECK-NEXT: $eax = MOV32ri 62
    ; CHECK-NEXT: $eax = SUB32ri $eax, 2, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 3, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 4, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 5, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 6, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 7, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 8, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 9, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 10, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 11, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 12, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 14, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 15, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @fifteen_with_cfi
    RET64
...
---
name: fifteen_instructions
tracksRegLiveness: true
body: |
  bb.0:
    $eax = MOV32ri 18
    $eax = ADD32ri $eax, 2, implicit-def $eflags
    $eax = ADD32ri $eax, 3, implicit-def $eflags
    $eax = ADD32ri $eax, 4, implicit-def $eflags
    $eax = ADD32ri $eax, 5, implicit-def $eflags
    $eax = ADD32ri $eax, 6, implicit-def $eflags
    $eax = ADD32ri $eax, 7, implicit-def $eflags
    $eax = ADD32ri $eax, 8, implicit-def $eflags
    $eax = ADD32ri $eax, 9, implicit-def $eflags
    $eax = ADD32ri $eax, 10, implicit-def $eflags
    $eax = ADD32ri $eax, 11, implicit-def $eflags
    $eax = ADD32ri $eax, 12, implicit-def $eflags
    $eax = ADD32ri $eax, 13, implicit-def $eflags
    $eax = ADD32ri $eax, 14, implicit-def $eflags
    $eax = ADD32ri $eax, 15, implicit-def $eflags
    RET64
...
---
name: fifteen_with_cfi
tracksRegLiveness: true
body: |
  bb.0:
    CFI_INSTRUCTION def_cfa_offset 16
    $eax = MOV32ri 62
    $eax = SUB32ri $eax, 2, implicit-def $eflags
    $eax = SUB32ri $eax, 3, implicit-def $eflags
    $eax = SUB32ri $eax, 4, implicit-def $eflags
    $eax = SUB32ri $eax, 5, implicit-def $eflags
    $eax = SUB32ri $eax, 6, implicit-def $eflags
    $eax = SUB32ri $eax, 7, implicit-def $eflags
    $eax = SUB32ri $eax, 8, implicit-def $eflags
    $eax = SUB32ri $eax, 9, implicit-def $eflags
    $eax = SUB32ri $eax, 10, implicit-def $eflags
    $eax = SUB32ri $eax, 11, implicit-def $eflags
    $eax = SUB32ri $eax, 12, implicit-def $eflags
    $eax = SUB32ri $eax, 13, implicit-def $eflags
    $eax = SUB32ri $eax, 14, implicit-def $eflags
    $eax = SUB32ri $eax, 15, implicit-def $eflags
    RET64
...
