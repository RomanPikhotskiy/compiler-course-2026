# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/pikhotskiy_r_lab3_BACKEND%shlibext -run-pass=pikhotskiy-inline-backend -verify-machineinstrs %s -o - | FileCheck %s

# Keep callers before callees in IR: llc frees each MachineFunction after
# running its pass pipeline. This keeps callee bodies available for all tests.

--- |
  define void @caller_keeps_large_call() {
    call void @oversized_callee()
    ret void
  }

  define void @oversized_callee() {
    ret void
  }

  define void @caller_keeps_multiblock_call() {
    call void @split_callee()
    ret void
  }

  define void @split_callee() {
    br label %next

  next:
    ret void
  }

  define void @two_call_sites() { ret void }
  define void @nested_calls() { ret void }
  define void @empty_call() { ret void }
  define void @call_in_second_block() { ret void }
  define void @unchanged_leaf() { ret void }
  define void @outer_step() { ret void }
  define void @mask_step() { ret void }
  define void @return_only() { ret void }

  define void @at_limit() { ret void }
  define void @at_limit_with_cfi() { ret void }
  define void @fifteen_instructions() { ret void }
  define void @fifteen_with_cfi() { ret void }

  define void @bounded_recursion() { ret void }

  define void @external_declaration() { ret void }
  define void @register_call() { ret void }
  define void @mixed_calls() { ret void }
  define void @local_marker() { ret void }
  declare void @runtime_hook()
...

# Reject oversized and multi-block callees.
---
name: oversized_callee
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    %14:gr32 = MOV32ri 14
    %15:gr32 = MOV32ri 15
    RET64

...
---
name: caller_keeps_large_call
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: caller_keeps_large_call
    ; CHECK: bb.0:
    ; CHECK-NEXT: CALL64pcrel32 @oversized_callee
    ; CHECK-NEXT: RET64
    CALL64pcrel32 @oversized_callee
    RET64

...
---
name: split_callee
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 3
    JMP_1 %bb.1

  bb.1:
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    RET64

...
---
name: caller_keeps_multiblock_call
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: caller_keeps_multiblock_call
    ; CHECK: bb.0:
    ; CHECK-NEXT: CALL64pcrel32 @split_callee
    ; CHECK-NEXT: RET64
    CALL64pcrel32 @split_callee
    RET64

...

# Inline calls and preserve register mappings.
---
name: two_call_sites
tracksRegLiveness: true
body: |
  bb.0:
    ; Existing %0 and %1 must survive, and each call needs fresh registers.
    ; CHECK-LABEL: name: two_call_sites
    ; CHECK: bb.0:
    ; CHECK-NEXT: %0:gr32 = MOV32ri 91
    ; CHECK-NEXT: %2:gr32 = MOV32ri 53
    ; CHECK-NEXT: %3:gr32 = AND32ri %2, 12, implicit-def $eflags
    ; CHECK-NEXT: %4:gr32 = MOV32ri 53
    ; CHECK-NEXT: %5:gr32 = AND32ri %4, 12, implicit-def $eflags
    ; CHECK-NEXT: %1:gr32 = SUB32ri %0, 6, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    %0:gr32 = MOV32ri 91
    CALL64pcrel32 @mask_step
    CALL64pcrel32 @mask_step
    %1:gr32 = SUB32ri %0, 6, implicit-def $eflags
    RET64
...
---
name: nested_calls
tracksRegLiveness: true
body: |
  bb.0:
    ; The call introduced by inlining outer_step is handled in another round.
    ; CHECK-LABEL: name: nested_calls
    ; CHECK: bb.0:
    ; CHECK-NEXT: %[[OUTER:[0-9]+]]:gr32 = MOV32ri 74
    ; CHECK-NEXT: %[[INNER:[0-9]+]]:gr32 = MOV32ri 53
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = AND32ri %[[INNER]], 12, implicit-def $eflags
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = XOR32ri %[[OUTER]], 9, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @outer_step
    RET64
...
---
name: empty_call
tracksRegLiveness: true
body: |
  bb.0:
    ; Only the caller's return remains; a callee RET must never be cloned.
    ; CHECK-LABEL: name: empty_call
    ; CHECK: bb.0:
    ; CHECK-NEXT: %0:gr32 = MOV32ri 28
    ; CHECK-NEXT: %1:gr32 = ADD32ri %0, 7, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    %0:gr32 = MOV32ri 28
    CALL64pcrel32 @return_only
    %1:gr32 = ADD32ri %0, 7, implicit-def $eflags
    RET64
...
---
name: call_in_second_block
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    JMP_1 %bb.1

  bb.1:
    ; Multiple blocks in the caller do not prevent inlining a one-block callee.
    ; CHECK-LABEL: name: call_in_second_block
    ; CHECK: JMP_1 %bb.1
    ; CHECK: bb.1:
    ; CHECK-NEXT: %[[BLOCKVAL:[0-9]+]]:gr32 = MOV32ri 53
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = AND32ri %[[BLOCKVAL]], 12, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @mask_step
    RET64
...
---
name: unchanged_leaf
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unchanged_leaf
    ; CHECK: bb.0:
    ; CHECK-NEXT: %0:gr32 = MOV32ri 67
    ; CHECK-NEXT: %1:gr32 = OR32ri %0, 8, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    %0:gr32 = MOV32ri 67
    %1:gr32 = OR32ri %0, 8, implicit-def $eflags
    RET64
...
---
name: outer_step
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 74
    CALL64pcrel32 @mask_step
    %1:gr32 = XOR32ri %0, 9, implicit-def $eflags
    RET64
...
---
name: mask_step
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 53
    %1:gr32 = AND32ri %0, 12, implicit-def $eflags
    RET64
...
---
name: return_only
tracksRegLiveness: true
body: |
  bb.0:
    RET64
...

# Accept exactly 15 body instructions and ignore CFI.
---
name: at_limit
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: at_limit{{$}}
    ; CHECK: bb.0:
    ; CHECK-NEXT: $eax = MOV32ri 18
    ; CHECK-NEXT: $eax = ADD32ri $eax, 2, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 3, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 4, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 5, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 6, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 7, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 8, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 9, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 10, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 11, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 12, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 14, implicit-def $eflags
    ; CHECK-NEXT: $eax = ADD32ri $eax, 15, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @fifteen_instructions
    RET64
...
---
name: at_limit_with_cfi
tracksRegLiveness: true
body: |
  bb.0:
    ; CFI must neither block inlining nor appear in the cloned body.
    ; CHECK-LABEL: name: at_limit_with_cfi
    ; CHECK: bb.0:
    ; CHECK-NEXT: $eax = MOV32ri 62
    ; CHECK-NEXT: $eax = SUB32ri $eax, 2, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 3, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 4, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 5, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 6, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 7, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 8, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 9, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 10, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 11, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 12, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 14, implicit-def $eflags
    ; CHECK-NEXT: $eax = SUB32ri $eax, 15, implicit-def $eflags
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @fifteen_with_cfi
    RET64
...
---
name: fifteen_instructions
tracksRegLiveness: true
body: |
  bb.0:
    $eax = MOV32ri 18
    $eax = ADD32ri $eax, 2, implicit-def $eflags
    $eax = ADD32ri $eax, 3, implicit-def $eflags
    $eax = ADD32ri $eax, 4, implicit-def $eflags
    $eax = ADD32ri $eax, 5, implicit-def $eflags
    $eax = ADD32ri $eax, 6, implicit-def $eflags
    $eax = ADD32ri $eax, 7, implicit-def $eflags
    $eax = ADD32ri $eax, 8, implicit-def $eflags
    $eax = ADD32ri $eax, 9, implicit-def $eflags
    $eax = ADD32ri $eax, 10, implicit-def $eflags
    $eax = ADD32ri $eax, 11, implicit-def $eflags
    $eax = ADD32ri $eax, 12, implicit-def $eflags
    $eax = ADD32ri $eax, 13, implicit-def $eflags
    $eax = ADD32ri $eax, 14, implicit-def $eflags
    $eax = ADD32ri $eax, 15, implicit-def $eflags
    RET64
...
---
name: fifteen_with_cfi
tracksRegLiveness: true
body: |
  bb.0:
    CFI_INSTRUCTION def_cfa_offset 16
    $eax = MOV32ri 62
    $eax = SUB32ri $eax, 2, implicit-def $eflags
    $eax = SUB32ri $eax, 3, implicit-def $eflags
    $eax = SUB32ri $eax, 4, implicit-def $eflags
    $eax = SUB32ri $eax, 5, implicit-def $eflags
    $eax = SUB32ri $eax, 6, implicit-def $eflags
    $eax = SUB32ri $eax, 7, implicit-def $eflags
    $eax = SUB32ri $eax, 8, implicit-def $eflags
    $eax = SUB32ri $eax, 9, implicit-def $eflags
    $eax = SUB32ri $eax, 10, implicit-def $eflags
    $eax = SUB32ri $eax, 11, implicit-def $eflags
    $eax = SUB32ri $eax, 12, implicit-def $eflags
    $eax = SUB32ri $eax, 13, implicit-def $eflags
    $eax = SUB32ri $eax, 14, implicit-def $eflags
    $eax = SUB32ri $eax, 15, implicit-def $eflags
    RET64
...

# Bound self-recursive expansion to three rounds.
---
name: bounded_recursion
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: bounded_recursion
    ; CHECK: bb.0:
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: %{{[0-9]+}}:gr32 = MOV32ri 39
    ; CHECK-NEXT: CALL64pcrel32 @bounded_recursion
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    %0:gr32 = MOV32ri 39
    CALL64pcrel32 @bounded_recursion
    RET64
...

# Preserve unsupported calls and continue scanning.
---
name: external_declaration
tracksRegLiveness: true
body: |
  bb.0:
    ; A declaration has no MachineFunction to inline.
    ; CHECK-LABEL: name: external_declaration
    ; CHECK: bb.0:
    ; CHECK-NEXT: CALL64pcrel32 @runtime_hook
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @runtime_hook
    RET64
...
---
name: register_call
tracksRegLiveness: true
body: |
  bb.0:
    ; No global Function operand: an indirect call must be left alone.
    ; CHECK-LABEL: name: register_call
    ; CHECK: bb.0:
    ; CHECK-NEXT: %0:gr64 = IMPLICIT_DEF
    ; CHECK-NEXT: CALL64r %0
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    %0:gr64 = IMPLICIT_DEF
    CALL64r %0
    RET64
...
---
name: mixed_calls
tracksRegLiveness: true
body: |
  bb.0:
    ; Skipping unsupported calls must not stop processing later direct calls.
    ; CHECK-LABEL: name: mixed_calls
    ; CHECK: bb.0:
    ; CHECK-NEXT: CALL64pcrel32 @runtime_hook
    ; CHECK-NEXT: %[[FIRST:[0-9]+]]:gr32 = MOV32ri 86
    ; CHECK-NEXT: %0:gr64 = IMPLICIT_DEF
    ; CHECK-NEXT: CALL64r %0
    ; CHECK-NEXT: %[[SECOND:[0-9]+]]:gr32 = MOV32ri 86
    ; CHECK-NEXT: CALL64pcrel32 @runtime_hook
    ; CHECK-NEXT: RET64
    ; CHECK-NEXT: {{^\.\.\.$}}
    CALL64pcrel32 @runtime_hook
    CALL64pcrel32 @local_marker
    %0:gr64 = IMPLICIT_DEF
    CALL64r %0
    CALL64pcrel32 @local_marker
    CALL64pcrel32 @runtime_hook
    RET64
...
---
name: local_marker
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 86
    RET64
...
